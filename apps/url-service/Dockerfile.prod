# --- Build stage ---
FROM node:22-alpine AS builder

RUN corepack enable

WORKDIR /app

# Copy monorepo files first
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Copy app package.json
COPY apps/url-service/package.json apps/url-service/package.json

# Install ONLY url-service deps
RUN pnpm install --filter url-service...

# Copy source
COPY apps/url-service apps/url-service

RUN pnpm --filter url-service build

# --- Runtime stage ---
FROM node:22-alpine

WORKDIR /app

# Copy compiled output
COPY --from=builder /app/apps/url-service/dist ./dist

# Copy required node_modules
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/url-service/node_modules ./apps/url-service/node_modules

ENV NODE_ENV=production

EXPOSE 3000
CMD ["node", "dist/main.js"]
